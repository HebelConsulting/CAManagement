<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>HebelConsulting.CAManagement.Pkcs11.Signing</PackageId>
        <Description>ICertificateSigner adapter signing CAManagement.X509 structures with PKCS#11 token keys (incl. ECDSA raw-to-DER signature conversion).</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CAManagement.X509\CAManagement.X509.csproj" />
        <ProjectReference Include="..\CAManagement.Pkcs11\CAManagement.Pkcs11.csproj" />
    </ItemGroup>

</Project>
