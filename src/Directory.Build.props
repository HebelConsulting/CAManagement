<Project>

    <PropertyGroup>
        <!-- Single version for all packages; bump here. -->
        <Version>0.7.0</Version>

        <Company>Hebel Consulting GmbH</Company>
        <Authors>Florian Hebel</Authors>
        <Copyright>© Hebel Consulting GmbH</Copyright>

        <!-- Packing is opt-in per library project. -->
        <IsPackable>false</IsPackable>

        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/HebelConsulting/CAManagement</PackageProjectUrl>
        <RepositoryUrl>https://github.com/HebelConsulting/CAManagement</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- A change is not done while it introduces (or leaves) a build warning: fix the cause, never
             suppress. Enforced here rather than as a CI flag so a local build refuses exactly the way CI
             does. NuGet audit advisories (NU1901-NU1904) are excluded — a freshly published advisory on a
             transitive dependency must not break every compile mid-task; the CI vulnerable-dependency scan
             owns blocking those instead, so the exclusion is a handover, not a hole. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

        <!-- Allow building net10.0-windows TFMs from macOS/Linux. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <!-- Debug info inside the assemblies; no separate symbol packages. -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
